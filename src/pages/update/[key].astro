---
// Partner update page (sheet PU, piece A). The key is a Partner Links Link Key, a secret in
// the URL. HSBS 7F (PARTNER_FLOW_URL) resolves it to one Active Partner Links row and lists
// that partner's open leads; Save posts to /api/partner-save. The flow URL never reaches
// the browser. Off (404) unless PARTNER_PAGE_ENABLED and REP_APP_ENABLED are both exactly
// true. No analytics. Contract: docs/field-flow-contract.md, "HSBS 7F".
import '../../styles/global.css';
import { clientIp, journeyLimited, secretUrlNotFound } from '../../lib/http';
import { PartnerFlowError, dealValueEnabled, listLeads, parkedEnabled, partnerPageEnabled } from '../../lib/partner-flow.mjs';
import {
  CLOSED_REASONS,
  DEAL_VALUE_INPUT_MAX,
  DEAL_VALUE_LABEL,
  MAX_UPDATES,
  NOTE_MAX,
  PARKED_BY_MAX,
  PARK_DATE_HINT,
  PARK_REASON_MAX,
  PRODUCT_MAX,
  SAVE_WORDS,
  easternToday,
  nextDay,
  withParkWords,
  dueLine,
  isPartnerKey,
  noChangeHint,
  nowLine,
  saveResultWords,
  savedWords,
  showDate,
} from '../../lib/partner-form.mjs';
import { choiceGroupsFor } from '../../lib/partner-status-words.mjs';

export const prerender = false;

if (!partnerPageEnabled()) {
  return secretUrlNotFound();
}

const key = String(Astro.params.key ?? '').trim();
let state: 'invalid' | 'expired' | 'busy' | 'unavailable' | 'ready' = 'invalid';
let partner = '';
let leads: Awaited<ReturnType<typeof listLeads>>['leads'] = [];

if (isPartnerKey(key)) {
  let ip: string;
  try {
    ip = Astro.clientAddress;
  } catch {
    ip = clientIp(Astro.request);
  }
  // Each open runs 7F. 60 per key per 10 minutes, with the per-IP backstop, as /refer.
  if (journeyLimited('partner-page', key, ip, 60, true)) {
    state = 'busy';
  } else {
    try {
      const answer = await listLeads(key);
      partner = answer.partner;
      leads = answer.leads;
      state = 'ready';
    } catch (err) {
      const kind = err instanceof PartnerFlowError ? err.kind : 'failed';
      state = kind === 'unknown' ? 'invalid' : kind === 'expired' ? 'expired' : 'unavailable';
      if (state === 'unavailable') console.error('update page: flow', kind, err instanceof PartnerFlowError ? err.status : 0);
    }
  }
}

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'same-origin');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.status = { invalid: 404, expired: 410, busy: 429, unavailable: 503, ready: 200 }[state];

const today = easternToday();
// Year 1 deal value (PARTNER_DEAL_VALUE_ENABLED). Off: no field, no data attribute, and the
// save body is exactly as before.
const dealOn = dealValueEnabled();
const storedDeal = (lead: (typeof leads)[number]) => ('dealValue' in lead ? lead.dealValue : '');
// Parked (PARTNER_PARKED_ENABLED). Off: no Set aside choices, no park fields, no data
// attribute, and the save body is exactly as before.
const parkOn = parkedEnabled();
const parkedUntil = (lead: (typeof leads)[number]) => (parkOn && 'parkedUntil' in lead ? String(lead.parkedUntil) : '');
// After a save the page reloads with ?saved=<n>&of=<sent>, so a partial or zero save keeps
// its words. A page opened before `of` existed sends ?saved=<n> alone: a full save.
const params = Astro.url.searchParams;
const savedParam = params.get('saved');
const ofParam = params.get('of');
const wholeParam = (v: string | null) => (v !== null && /^\d{1,3}$/.test(v) ? Number(v) : NaN);
const savedCount = wholeParam(savedParam);
const savedWordsOnly =
  state !== 'ready' || savedParam === null
    ? ''
    : ofParam === null
      ? savedCount > 0 && savedCount <= MAX_UPDATES
        ? savedWords(savedCount)
        : ''
      : (saveResultWords(savedCount, wholeParam(ofParam)) ?? '');
// ?nd=<n>: parks with no revisit date in that save, which 7F saved as Closed Lost (E22).
const saved = parkOn ? withParkWords(savedWordsOnly, savedCount, wholeParam(ofParam), wholeParam(params.get('nd'))) : savedWordsOnly;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <meta name="theme-color" content="#002f6d" />
    <title>{partner ? `Lead updates | ${partner}` : 'Lead updates'}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="pu">
    <header class="pu-top">
      <img src="/logos/HSBS_horizontal_color.svg" alt="Henry Schein Business Solutions" height="32" />
    </header>

    <main class="pu-main" id="main">
      {
        state === 'invalid' && (
          <section class="pu-card">
            <h1>{SAVE_WORDS.badLink}</h1>
            <p>Open the update link in your latest email from HSBS.</p>
          </section>
        )
      }
      {
        state === 'expired' && (
          <section class="pu-card">
            <h1>{SAVE_WORDS.expired}</h1>
          </section>
        )
      }
      {
        state === 'busy' && (
          <section class="pu-card">
            <h1>{SAVE_WORDS.busy}</h1>
          </section>
        )
      }
      {
        state === 'unavailable' && (
          <section class="pu-card">
            <h1>This page is not available right now.</h1>
            <p>Try the link again in a few minutes.</p>
          </section>
        )
      }

      {
        state === 'ready' && (
          <form id="pu-form" class="pu-form" data-key={key} data-deal-value={dealOn ? 'on' : undefined} data-parked={parkOn ? 'on' : undefined} novalidate>
            <h1 class="pu-h1">{partner ? `Lead updates for ${partner}` : 'Lead updates'}</h1>
            <p class="pu-intro">
              Please update each lead within 2 business days. Answer only the leads that changed, then press Save once.
            </p>
            <p id="pu-status" class="pu-status" role="status" aria-live="polite">{saved}</p>
            <noscript>
              <p class="pu-status">Turn on JavaScript to save updates.</p>
            </noscript>

            {leads.length === 0 && <p class="pu-card">No leads need an update right now. Thank you.</p>}

            <ol class="pu-leads">
              {leads.map((lead) => (
                <li class="pu-lead" data-id={String(lead.id)} data-ref={lead.ref} data-ask-offices={lead.askOffices ? 'true' : undefined} data-deal-value={dealOn ? storedDeal(lead) : undefined}>
                  <fieldset class="pu-card" aria-labelledby={`lead-${lead.id}-title`}>
                    <h2 class="pu-ref" id={`lead-${lead.id}-title`}>
                      {lead.ref}: {lead.practice}
                    </h2>
                    {/* A lead with a complete answer folds to this line. Every input stays in the
                        form, hidden, so Save sends it exactly as before (Release A). */}
                    <div class="pu-picked" data-picked hidden>
                      <p class="pu-picked-words" id={`picked-${lead.id}`} data-picked-words />
                      <button type="button" class="pu-change" data-change aria-describedby={`picked-${lead.id} lead-${lead.id}-title`}>
                        Change
                      </button>
                    </div>
                    <div class="pu-open" data-open>
                    <dl class="pu-facts">
                      <div>
                        <dt>Contact</dt>
                        <dd>{lead.contact || 'Not given'}</dd>
                      </div>
                      <div>
                        <dt>Service</dt>
                        <dd>{lead.company || 'Not given'}</dd>
                      </div>
                      <div>
                        <dt>Introduced</dt>
                        <dd>{showDate(lead.introducedOn) || 'Not yet'}</dd>
                      </div>
                      <div>
                        <dt>Stage</dt>
                        <dd>{nowLine(lead.status, lead.meetingDate, parkedUntil(lead))}</dd>
                      </div>
                      <div>
                        <dt>Next update</dt>
                        <dd class={lead.missedUpdates > 0 ? 'pu-due--late' : ''}>{dueLine(lead.missedUpdates, lead.nextUpdateDue)}</dd>
                      </div>
                    </dl>

                    <fieldset class="pu-q" data-q="choice">
                      <legend>Where does it stand?</legend>
                      {choiceGroupsFor(lead.status, { on: parkOn, parked: parkedUntil(lead) !== '' }).map((g) => (
                        <div class="pu-group">
                          {g.heading && <p class="pu-group-h">{g.heading}</p>}
                          {g.note && <p class="pu-group-note">{g.note}</p>}
                          {g.done && <p class="pu-done" data-done={g.group}>{g.done} (done)</p>}
                          {g.choices.map((c) => (
                            <label class="pu-opt">
                              <input type="radio" name={`choice-${lead.id}`} value={c.code} />
                              <span>
                                {c.label}
                                {c.hint && <span class="pu-hint">{c.hint}</span>}
                              </span>
                            </label>
                          ))}
                        </div>
                      ))}
                    </fieldset>

                    <label class="pu-opt pu-checkin">
                      <input type="checkbox" name={`nochange-${lead.id}`} value="nochange" data-nochange />
                      <span>
                        No change this week
                        <span class="pu-hint">{noChangeHint(lead.status, parkedUntil(lead))}</span>
                      </span>
                    </label>

                    {lead.askOffices && (
                      <fieldset class="pu-more pu-q" data-for="qualifying" data-offices hidden>
                        <legend>The rep marked this practice as a group. Does it have 3 or more locations?</legend>
                        <label class="pu-opt">
                          <input type="radio" name={`offices-${lead.id}`} value="yes" />
                          <span>Yes, 3 or more locations</span>
                        </label>
                        <label class="pu-opt">
                          <input type="radio" name={`offices-${lead.id}`} value="no" />
                          <span>No, fewer than 3</span>
                        </label>
                      </fieldset>
                    )}
                    <div class="pu-more" data-for="meeting" hidden>
                      <label class="pu-field">
                        <span>Demo date</span>
                        <input type="date" name={`meetingDate-${lead.id}`} min={today} />
                      </label>
                    </div>
                    <div class="pu-more" data-for="signed" hidden>
                      <label class="pu-field">
                        <span>Signed date</span>
                        <input type="date" name={`signedDate-${lead.id}`} max={today} />
                      </label>
                      <label class="pu-field">
                        <span>Product (optional)</span>
                        <input type="text" name={`signedProduct-${lead.id}`} maxlength={PRODUCT_MAX} autocomplete="off" />
                      </label>
                    </div>
                    {dealOn && (
                      <div class="pu-more" data-for="deal" hidden>
                        <label class="pu-field">
                          <span>{DEAL_VALUE_LABEL}</span>
                          <input
                            type="text"
                            inputmode="numeric"
                            name={`dealValue-${lead.id}`}
                            maxlength={DEAL_VALUE_INPUT_MAX}
                            autocomplete="off"
                            value={storedDeal(lead)}
                          />
                        </label>
                      </div>
                    )}
                    {parkOn && (
                      <div class="pu-more" data-for="parked" hidden>
                        <label class="pu-field">
                          <span>Revisit date</span>
                          <input type="date" name={`parkDate-${lead.id}`} min={nextDay(today)} aria-describedby={`parkhint-${lead.id}`} />
                        </label>
                        <p class="pu-hint" id={`parkhint-${lead.id}`}>{PARK_DATE_HINT}</p>
                        <label class="pu-field">
                          <span>Reason for setting it aside</span>
                          <input type="text" name={`parkReason-${lead.id}`} maxlength={PARK_REASON_MAX} autocomplete="off" />
                        </label>
                        <label class="pu-field">
                          <span>Your name</span>
                          <input type="text" name={`parkedBy-${lead.id}`} maxlength={PARKED_BY_MAX} autocomplete="name" />
                        </label>
                      </div>
                    )}
                    <div class="pu-more" data-for="lost" hidden>
                      <label class="pu-field">
                        <span>Reason</span>
                        <select name={`closedReason-${lead.id}`}>
                          <option value="">Pick a reason</option>
                          {CLOSED_REASONS.map((r) => (
                            <option value={r}>{r}</option>
                          ))}
                        </select>
                      </label>
                    </div>
                    <label class="pu-field">
                      <span data-note-label>Note (optional)</span>
                      <input type="text" name={`note-${lead.id}`} maxlength={NOTE_MAX} autocomplete="off" />
                    </label>
                    <p class="pu-err" role="alert" hidden />
                    </div>
                  </fieldset>
                </li>
              ))}
            </ol>

            {leads.length > 0 && (
              <div class="pu-savebar">
                <button type="submit" id="pu-save" class="pu-save" disabled>
                  Save
                </button>
              </div>
            )}
          </form>
        )
      }
    </main>

    <style is:global>
      body.pu { background: var(--bg-accent); }
      .pu-top { background: #fff; border-bottom: 3px solid var(--hs-navy); padding: 0.85rem 1rem; }
      .pu-top img { height: 32px; width: auto; display: block; }
      .pu-main { width: min(100% - 1.5rem, 40rem); margin: 0 auto; padding: 1rem 0 calc(1.5rem + env(safe-area-inset-bottom)); }
      .pu-card {
        background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow);
        padding: 1rem; margin: 0 0 0.9rem; min-width: 0;
      }
      .pu-card h1 { font-size: 1.3rem; color: var(--hs-navy); margin: 0 0 0.4rem; }
      .pu-h1 { font-size: 1.4rem; color: var(--hs-navy); margin: 0.2rem 0 0.4rem; overflow-wrap: anywhere; }
      .pu-intro { margin: 0 0 0.6rem; }
      .pu-status { font-weight: 600; margin: 0 0 0.8rem; min-height: 1.2em; overflow-wrap: anywhere; }
      .pu-leads { list-style: none; margin: 0; padding: 0; }
      .pu-ref { font-size: 1.1rem; color: var(--hs-navy); margin: 0 0 0.25rem; overflow-wrap: anywhere; }
      .pu-facts { margin: 0.4rem 0 0.6rem; display: grid; gap: 0.35rem; font-size: 1rem; }
      .pu-facts div { display: grid; grid-template-columns: 8.5rem 1fr; gap: 0.5rem; }
      .pu-facts dt { margin: 0; color: var(--muted); font-weight: 600; }
      .pu-facts dd { margin: 0; overflow-wrap: anywhere; }
      .pu-due--late { color: var(--btn-red); font-weight: 700; }
      .pu-q { border: 0; margin: 0.6rem 0 0; padding: 0; min-width: 0; }
      .pu-q legend { font-weight: 600; margin-bottom: 0.2rem; padding: 0; }
      .pu-opt { display: flex; align-items: center; gap: 0.6rem; min-height: 44px; cursor: pointer; overflow-wrap: anywhere; }
      .pu-opt input { width: 1.2rem; height: 1.2rem; flex: 0 0 auto; margin: 0; }
      .pu-group { margin: 0.2rem 0 0.4rem; }
      .pu-group-h { margin: 0.5rem 0 0; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
      .pu-checkin { margin-top: 0.4rem; padding: 0.3rem 0.6rem; border: 1px dashed var(--line); border-radius: 8px; }
      .pu-opt input:disabled + span { color: var(--muted); }
      .pu-done { margin: 0.2rem 0 0; min-height: 44px; display: flex; align-items: center; font-weight: 600; color: var(--muted); }
      .pu-hint { display: block; font-size: 0.9rem; color: var(--muted); }
      .pu-field { display: flex; flex-direction: column; gap: 0.25rem; margin: 0.6rem 0 0; font-weight: 600; }
      .pu-field input, .pu-field select {
        min-height: 44px; font: inherit; font-weight: 400; padding: 0.4rem 0.6rem; border: 1px solid var(--line);
        border-radius: 8px; width: 100%; box-sizing: border-box; background: #fff;
      }
      .pu-more[hidden], .pu-err[hidden] { display: none; }
      .pu-err { color: var(--btn-red); font-weight: 600; margin: 0.6rem 0 0; overflow-wrap: anywhere; }
      .pu-card:disabled { opacity: 0.75; }
      /* Sticky Save (Release A). It sits in the form's flow at the end, so it never covers the
         last card; scroll-padding keeps a focused field or error clear of it mid-list. */
      html:has(body.pu) { scroll-padding-bottom: 6rem; }
      .pu-savebar {
        position: sticky; bottom: 0; z-index: 2; margin: 0.4rem 0 0;
        padding: 0.6rem 0 calc(0.6rem + env(safe-area-inset-bottom));
        background: var(--bg-accent); box-shadow: 0 -8px 12px -10px rgba(0, 47, 109, 0.35);
      }
      .pu-group-note { margin: 0.15rem 0 0.1rem; font-size: 0.9rem; color: var(--muted); }
      .pu-picked { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin: 0.4rem 0 0; }
      .pu-picked[hidden], .pu-open[hidden] { display: none; }
      .pu-picked-words { margin: 0; font-weight: 600; flex: 1 1 12rem; overflow-wrap: anywhere; }
      .pu-change {
        min-height: 44px; min-width: 44px; padding: 0 1rem; font: inherit; font-weight: 600; color: var(--hs-navy);
        background: #fff; border: 1px solid var(--hs-navy); border-radius: 8px; cursor: pointer;
      }
      .pu-save {
        min-height: 48px; width: 100%; font: inherit; font-weight: 700; font-size: 1.05rem; border: 0; border-radius: 10px;
        background: var(--hs-blue); color: #fff; cursor: pointer;
      }
      .pu-save:disabled { opacity: 0.6; cursor: default; }
      /* Navy focus ring: 13:1 on white (sky was 2.65:1, under the 3:1 floor). */
      .pu-save:focus-visible, .pu-change:focus-visible, .pu-opt input:focus-visible, .pu-field input:focus-visible, .pu-field select:focus-visible {
        outline: 3px solid var(--hs-navy); outline-offset: 2px;
      }
    </style>

    <script>
      import { CLIENT_WAIT_MS } from '../../lib/field-form.mjs';
      import {
        DEAL_VALUE_CHOICES,
        MAX_UPDATES,
        QUALIFYING_CHOICES,
        SAVE_WORDS,
        checkUpdate,
        dealValueDigits,
        dealValueOf,
        easternToday,
        fieldWords,
        pickedWords,
        reloadWords,
        saveLabel,
        saveResultWords,
      } from '../../lib/partner-form.mjs';

      const form = document.getElementById('pu-form') as HTMLFormElement | null;
      const button = document.getElementById('pu-save') as HTMLButtonElement | null;
      const status = document.getElementById('pu-status');
      if (form && button && status) {
        const key = form.dataset.key ?? '';
        // Year 1 deal value switch, set by the server. Off: no dealValue is read or sent.
        const dealOn = form.dataset.dealValue === 'on';
        // Parked switch, set by the server. Off: no park field is read or sent.
        const parkOn = form.dataset.parked === 'on';
        const checkOpts = { dealValue: dealOn, parked: parkOn };
        const leads = [...form.querySelectorAll<HTMLLIElement>('.pu-lead')];
        // A save with no clear answer keeps its id and its exact body, so Save resends it.
        let pending: { submissionId: string; updates: Record<string, unknown>[] } | null = null;
        let busy = false;
        // True from pointer down until just after pointer up (see focusout below).
        let pressing = false;

        const noChange = (li: HTMLLIElement) => li.querySelector<HTMLInputElement>('input[data-nochange]');
        const stageInputs = (li: HTMLLIElement) => [...li.querySelectorAll<HTMLInputElement>(`input[name="choice-${li.dataset.id}"]`)];
        const field = (li: HTMLLIElement, name: string) => {
          // No change is a check-in, not a stage: ticked, it is the answer and the stage stays.
          if (name === 'choice' && noChange(li)?.checked) return 'nochange';
          const item = form.elements.namedItem(`${name}-${li.dataset.id}`);
          if (!item) return '';
          if (item instanceof RadioNodeList) return item.value;
          return (item as HTMLInputElement).value.trim();
        };
        const card = (li: HTMLLIElement) => li.querySelector('fieldset.pu-card') as HTMLFieldSetElement;
        const errorLine = (li: HTMLLIElement) => li.querySelector('.pu-err') as HTMLElement;
        const touched = (li: HTMLLIElement) => Boolean(field(li, 'choice') || field(li, 'note'));
        // The deal value to send: what the partner typed, $ and commas dropped. The stored value
        // left as it is goes blank, so a resave keeps it and does not restamp its date.
        const dealSent = (li: HTMLLIElement) => {
          const typed = dealValueDigits(field(li, 'dealValue'));
          return typed !== '' && dealValueOf(typed) === (li.dataset.dealValue ?? '') ? '' : typed;
        };
        // One lead's answer as checkUpdate reads it. Save and the live count both use this.
        const answer = (li: HTMLLIElement) => ({
          id: Number(li.dataset.id),
          choice: field(li, 'choice'),
          meetingDate: field(li, 'meetingDate'),
          signedDate: field(li, 'signedDate'),
          signedProduct: field(li, 'signedProduct'),
          closedReason: field(li, 'closedReason'),
          note: field(li, 'note'),
          offices: li.dataset.askOffices === 'true' ? field(li, 'offices') : '',
          askOffices: li.dataset.askOffices === 'true',
          ...(dealOn ? { dealValue: dealSent(li) } : {}),
          ...(parkOn ? { parkDate: field(li, 'parkDate'), parkReason: field(li, 'parkReason'), parkedBy: field(li, 'parkedBy') } : {}),
        });
        // Complete: an answer Save would send as it stands, follow-up fields included.
        const complete = (li: HTMLLIElement) => touched(li) && checkUpdate(answer(li), easternToday(), checkOpts).ok;

        // Release A: the sticky Save counts complete leads (each once), and a complete lead
        // folds to "Selected: <answer>" with Change. Folding only hides; every value stays in
        // the form, so collect() and the 7F body are unchanged.
        const openPart = (li: HTMLLIElement) => li.querySelector('[data-open]') as HTMLElement;
        const pickedPart = (li: HTMLLIElement) => li.querySelector('[data-picked]') as HTMLElement;
        const folded = (li: HTMLLIElement) => openPart(li).hidden;
        const refresh = () => {
          button.textContent = saveLabel(leads.filter(complete).length);
          // Nothing picked: Save stays off. Something picked but not complete: Save stays on,
          // so pressing it names what is missing. A pending resend keeps Save on.
          if (!busy && !pending) button.disabled = !leads.some(touched);
        };
        const fold = (li: HTMLLIElement) => {
          if (busy || folded(li) || !complete(li)) return;
          const had = li.contains(document.activeElement);
          (li.querySelector('[data-picked-words]') as HTMLElement).textContent = pickedWords(field(li, 'choice'));
          openPart(li).hidden = true;
          pickedPart(li).hidden = false;
          if (had) li.querySelector<HTMLButtonElement>('[data-change]')?.focus();
        };
        const unfold = (li: HTMLLIElement, focusAnswer: boolean) => {
          if (!folded(li)) return;
          openPart(li).hidden = false;
          pickedPart(li).hidden = true;
          if (!focusAnswer) return;
          const checked = li.querySelector<HTMLInputElement>('input[type="radio"]:checked:not([name^="offices-"]), input[data-nochange]:checked');
          (checked ?? li.querySelector<HTMLInputElement>('input:not([disabled])'))?.focus();
        };

        const showMore = (li: HTMLLIElement) => {
          const choice = field(li, 'choice');
          li.querySelectorAll<HTMLElement>('[data-for]').forEach((el) => {
            const f = el.dataset.for;
            el.hidden = f === 'qualifying' ? !QUALIFYING_CHOICES.includes(choice) : f === 'deal' ? !DEAL_VALUE_CHOICES.includes(choice) : f !== choice;
          });
        };
        leads.forEach((li) => {
          showMore(li);
          // A complete card folds once the partner moves on: Tab out of it, or click or tap
          // anywhere else (below). Never on the pick itself, so arrowing through the stages or
          // changing your mind inside the card costs nothing.
          li.addEventListener('input', refresh);
          li.addEventListener('focusout', (event) => {
            // A press moves focus on pointer down; folding then would shift the page under the
            // pointer and lose the click (Save at the end of the page). The click handler folds.
            if (pressing) return;
            const next = (event as FocusEvent).relatedTarget as Node | null;
            if (next && !li.contains(next)) fold(li);
          });
          li.querySelector('[data-change]')?.addEventListener('click', () => unfold(li, true));
          li.addEventListener('change', (event) => {
            const box = noChange(li);
            if (box && event.target === box) {
              // Ticked: the stage list clears and greys out, so the saved stage stays as it is.
              for (const input of stageInputs(li)) {
                if (box.checked) input.checked = false;
                input.disabled = box.checked;
              }
            }
            showMore(li);
            refresh();
          });
        });
        // After a click lands (not on press, so nothing moves under a finger mid-tap), fold every
        // other complete card. Safari does not focus a clicked radio, so focusout alone misses it.
        document.addEventListener('pointerdown', () => (pressing = true), true);
        document.addEventListener('pointerup', () => setTimeout(() => (pressing = false)), true);
        document.addEventListener('pointercancel', () => (pressing = false), true);
        document.addEventListener('click', (event) => {
          for (const li of leads) if (!li.contains(event.target as Node)) fold(li);
        });

        const clearErrors = () =>
          leads.forEach((li) => {
            const line = errorLine(li);
            line.hidden = true;
            line.textContent = '';
          });
        const flag = (li: HTMLLIElement, words: string) => {
          unfold(li, false);
          const line = errorLine(li);
          line.textContent = words;
          line.hidden = false;
        };
        const lock = (on: boolean) => leads.forEach((li) => (card(li).disabled = on));
        const byId = (id: unknown) => leads.find((li) => li.dataset.id === String(id));

        const collect = () => {
          const today = easternToday();
          const updates: Record<string, unknown>[] = [];
          let first: { li: HTMLLIElement; words: string; field: string } | null = null;
          for (const li of leads) {
            if (!touched(li)) continue;
            const ref = li.dataset.ref ?? '';
            const result = checkUpdate(answer(li), today, checkOpts);
            if (result.ok) {
              // The server fills in Talked To Doctor from the choice. Sending one marks an
              // old page (docs/field-flow-contract.md, 7F), so the new page leaves it out.
              const sent = { ...result.update };
              delete sent.talkedToDoctor;
              updates.push(sent);
            } else {
              const words = fieldWords(ref, result.field);
              flag(li, words);
              first ??= { li, words, field: result.field };
            }
          }
          return { updates, first };
        };

        const send = async (submissionId: string, updates: Record<string, unknown>[]) => {
          busy = true;
          button.disabled = true;
          lock(true);
          status.textContent = SAVE_WORDS.sending;
          const controller = new AbortController();
          const timer = setTimeout(() => controller.abort(), CLIENT_WAIT_MS);
          let res: Response | null = null;
          let data: Record<string, unknown> | null = null;
          try {
            res = await fetch('/api/partner-save', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ key, submissionId, updates }),
              signal: controller.signal,
            });
            data = await res.json().catch(() => null);
          } catch {
            res = null;
          } finally {
            clearTimeout(timer);
          }
          busy = false;
          const code = res?.status ?? 0;
          // A 200 whose count is above what was sent is not a save answer: no clear answer.
          const savedCount = code === 200 && data?.ok === true && typeof data.saved === 'number' ? data.saved : NaN;
          const doneWords = saveResultWords(savedCount, updates.length);
          if (doneWords !== null) {
            pending = null;
            status.textContent = doneWords;
            const noDate = parkOn && typeof data?.parkNoDate === 'number' && data.parkNoDate > 0 ? `&nd=${data.parkNoDate}` : '';
            location.replace(`${location.pathname}?saved=${savedCount}&of=${updates.length}${noDate}`);
            return;
          }
          if (code === 404 || code === 410) {
            pending = null;
            status.textContent = code === 410 ? SAVE_WORDS.expired : SAVE_WORDS.badLink;
            return;
          }
          if (code === 400 || code === 422) {
            // A clear refusal: nothing in this save was written. Every typed answer stays.
            pending = null;
            lock(false);
            button.disabled = false;
            const li = byId(data?.id);
            const ref = li?.dataset.ref ?? '';
            let words = typeof data?.message === 'string' ? data.message : 'Check your answers, then press Save again.';
            if (li && data?.error === 'reload') words = reloadWords(ref);
            else if (li) words = fieldWords(ref, typeof data?.field === 'string' ? data.field : '');
            if (li) flag(li, words);
            status.textContent = words;
            return;
          }
          // No clear answer (timeout, dropped connection, 429, 5xx): it may have gone through.
          // Keep the id and the exact updates; the answers stay locked so Save resends them.
          pending = { submissionId, updates };
          button.disabled = false;
          status.textContent = code === 429 ? SAVE_WORDS.busy : SAVE_WORDS.timeout;
        };

        form.addEventListener('submit', (event) => {
          event.preventDefault();
          if (busy) return;
          if (pending) {
            void send(pending.submissionId, pending.updates);
            return;
          }
          clearErrors();
          const { updates, first } = collect();
          if (first) {
            status.textContent = first.words;
            // Focus the field that is missing, next to its error, and keep the error clear of the
            // sticky Save (scroll-padding-bottom).
            // A park missing both reason and name focuses the reason first.
            const focusName = first.field === 'parkReasonBy' ? 'parkReason' : first.field;
            const named = first.li.querySelector<HTMLElement>(`[name="${focusName}-${first.li.dataset.id}"]`);
            (named ?? first.li.querySelector<HTMLElement>('input, select'))?.focus();
            errorLine(first.li).scrollIntoView({ block: 'nearest' });
            return;
          }
          if (updates.length === 0) {
            status.textContent = SAVE_WORDS.nothing;
            return;
          }
          if (updates.length > MAX_UPDATES) {
            status.textContent = SAVE_WORDS.tooMany;
            return;
          }
          void send(crypto.randomUUID(), updates);
        });

        refresh();
        // A saved message shows once; a refresh does not repeat it.
        if (location.search.includes('saved=')) history.replaceState(null, '', location.pathname);
      }
    </script>
  </body>
</html>
