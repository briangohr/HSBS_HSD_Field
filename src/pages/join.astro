---
// Rep sign-up: the QR code target (/j redirects here with ?src=qr). One time, about a
// minute. The page script posts /api/register. Without JavaScript, the form POSTs to
// /join itself and the server runs the same path (submitRegistration), so the rep's
// details never go in the URL. The page stores nothing.
// Off (404) unless REP_APP_ENABLED=true (spec D14). Spec: docs/field-flow-contract.md.
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { clientIp } from '../lib/http';
import { repAppEnabled } from '../lib/register-flow.mjs';
import { RGM_NOT_LISTED, ROLES, SENT_MESSAGE, rgmLabel, roleLabel } from '../lib/register-form.mjs';
import { joinRgms, pickFields, submitRegistration, type SubmitResult } from '../lib/register-submit';

export const prerender = false;

if (!repAppEnabled()) {
  return new Response('Not found', { status: 404, headers: { 'content-type': 'text/plain; charset=utf-8' } });
}

const MAX_BODY = 4 * 1024;
// JOIN_RGMS set: the roster-match form (RGM pick list, no manager or branch boxes).
const rgms = joinRgms();
let src = (Astro.url.searchParams.get('src') ?? '').slice(0, 20);
let values: Record<string, string> = {};
let result: SubmitResult | undefined;

if (Astro.request.method === 'POST') {
  const length = Number(Astro.request.headers.get('content-length') ?? '0');
  let form: FormData | undefined;
  if (length <= MAX_BODY) {
    try {
      form = await Astro.request.formData();
    } catch {
      form = undefined;
    }
  }
  if (!form) {
    result = { status: 400, error: 'Sign-up did not send. Please try again.' };
  } else {
    values = pickFields((k) => form.get(k));
    src = values.src.slice(0, 20);
    let ip: string;
    try {
      ip = Astro.clientAddress;
    } catch {
      ip = clientIp(Astro.request);
    }
    result = await submitRegistration(values, ip);
  }
  Astro.response.status = result.status;
}

const sent = result?.ok === true;
const errors = result?.errors ?? {};
const v = (k: string) => (sent ? '' : (values[k] ?? ''));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    {/* same-origin, not no-referrer: a no-JavaScript form POST must carry this site's
        Origin, or Astro's cross-site check refuses it. /join holds no secret in its URL. */}
    <meta name="referrer" content="same-origin" />
    <meta name="theme-color" content="#002f6d" />
    <title>Set up your HSBS app</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <Analytics />
  </head>
  <body class="join">
    <header class="join-top">
      <img src="/logos/HSBS_horizontal_color.svg" alt="Henry Schein Business Solutions" height="32" />
    </header>

    <main class="join-main" id="main">
      <section class="join-card" id="join-form-card" hidden={sent}>
        <h1>Set up your HSBS app.</h1>
        <p class="join-sub">One time, about a minute.</p>

        <form id="join-form" method="post" action="/join" novalidate data-src={src}>
          <input type="hidden" name="src" value={src} />
          <div class="join-row">
            <label class="join-field">
              First name
              <input name="firstName" value={v('firstName')} autocomplete="given-name" maxlength="60" required />
              <span class="join-err" data-for="firstName">{errors.firstName ?? ''}</span>
            </label>
            <label class="join-field">
              Last name
              <input name="lastName" value={v('lastName')} autocomplete="family-name" maxlength="60" required />
              <span class="join-err" data-for="lastName">{errors.lastName ?? ''}</span>
            </label>
          </div>

          <label class="join-field">
            Henry Schein email
            <input name="email" value={v('email')} type="email" inputmode="email" autocomplete="email" maxlength="120" required placeholder="first.last@henryschein.com" />
            <span class="join-hint">Must end in @henryschein.com.</span>
            <span class="join-err" data-for="email">{errors.email ?? ''}</span>
          </label>

          <label class="join-field">
            Mobile
            <input name="mobile" value={v('mobile')} type="tel" inputmode="tel" autocomplete="tel" maxlength="20" required />
            <span class="join-err" data-for="mobile">{errors.mobile ?? ''}</span>
          </label>

          <label class="join-field">
            Role
            <select name="role" required>
              <option value="">Pick one</option>
              {ROLES.map((role) => <option value={role} selected={v('role') === role}>{roleLabel(role)}</option>)}
            </select>
            <span class="join-err" data-for="role">{errors.role ?? ''}</span>
          </label>

          {rgms.length ? (
            <label class="join-field">
              Your RGM <span class="join-hint">(Regional General Manager)</span>
              <span class="join-hint" id="rgm-optional">(optional for HSFS and Other)</span>
              <select name="rgm">
                <option value="">Pick one</option>
                {rgms.map((r) => <option value={r.region} selected={v('rgm') === r.region}>{rgmLabel(r)}</option>)}
                <option value={RGM_NOT_LISTED} selected={v('rgm') === RGM_NOT_LISTED}>Not listed, or I don't know</option>
              </select>
              <span class="join-hint">If you're on the field roster, we use the roster's manager.</span>
              <span class="join-err" data-for="rgm">{errors.rgm ?? ''}</span>
            </label>
          ) : (
            <>
            <label class="join-field">
              Manager's name <span class="join-hint">(optional for AE, HSFS and Other)</span>
              <input name="managerName" value={v('managerName')} autocomplete="off" maxlength="120" />
              <span class="join-err" data-for="managerName">{errors.managerName ?? ''}</span>
            </label>

            <label class="join-field">
              Manager's Henry Schein email <span class="join-hint">(optional for AE, HSFS and Other)</span>
              <input name="managerEmail" value={v('managerEmail')} type="email" inputmode="email" autocomplete="off" maxlength="120" />
              <span class="join-err" data-for="managerEmail">{errors.managerEmail ?? ''}</span>
            </label>

            <label class="join-field">
              Branch or territory
              <input name="branch" value={v('branch')} autocomplete="off" maxlength="80" required />
              <span class="join-err" data-for="branch">{errors.branch ?? ''}</span>
            </label>
            </>
          )}

          <p class="join-alert" id="join-alert" role="alert" hidden={!result?.error}>{result?.error ?? ''}</p>
          <button class="join-send" type="submit" id="join-send">Send my link</button>
        </form>
      </section>

      <section class="join-card" id="join-sent" hidden={!sent}>
        <h1>Check your email.</h1>
        <p>{SENT_MESSAGE}</p>
      </section>
    </main>

    <script>
      import { RGM_NOT_LISTED, RGM_OPTIONAL_ROLES, validateRegistration } from '../lib/register-form.mjs';

      const form = document.getElementById('join-form') as HTMLFormElement;
      const send = document.getElementById('join-send') as HTMLButtonElement;
      const alertBox = document.getElementById('join-alert') as HTMLElement;
      const formCard = document.getElementById('join-form-card') as HTMLElement;
      const sentCard = document.getElementById('join-sent') as HTMLElement;
      const pick = form.elements.namedItem('rgm') as HTMLSelectElement | null;
      const role = form.elements.namedItem('role') as HTMLSelectElement;
      const rgmOptionalHint = document.getElementById('rgm-optional');

      if (pick && rgmOptionalHint) {
        rgmOptionalHint.textContent = '(optional)';
        const showRgmRequirement = () => {
          pick.required = !RGM_OPTIONAL_ROLES.includes(role.value);
          rgmOptionalHint.hidden = pick.required;
        };
        role.addEventListener('change', showRgmRequirement);
        showRgmRequirement();
      }

      const showErrors = (errors: Record<string, string>) => {
        form.querySelectorAll<HTMLElement>('.join-err').forEach((el) => {
          el.textContent = errors[el.dataset.for ?? ''] ?? '';
        });
        const first = Object.keys(errors)[0];
        if (first) (form.elements.namedItem(first) as HTMLElement | null)?.focus();
      };

      const say = (text: string) => {
        alertBox.textContent = text;
        alertBox.hidden = !text;
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        say('');
        const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
        // The pick list's codes, so the page checks the same rule as the server. The
        // RGM emails never reach the page; the server checks the rest.
        const rgms = pick
          ? [...pick.options].filter((o) => o.value && o.value !== RGM_NOT_LISTED).map((o) => ({ region: o.value, name: 'RGM', email: '' }))
          : [];
        const check = validateRegistration(data, rgms);
        if (!check.ok) {
          showErrors(check.errors);
          return;
        }
        showErrors({});
        send.disabled = true;
        send.textContent = 'Sending...';
        try {
          const res = await fetch('/api/register', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(data),
          });
          const body = await res.json().catch(() => ({}));
          if (res.ok && body.ok) {
            formCard.hidden = true;
            sentCard.hidden = false;
            sentCard.querySelector('h1')?.focus();
            return;
          }
          if (body.errors) showErrors(body.errors);
          say(body.error ?? 'Sign-up is not available right now.');
        } catch {
          say('Sign-up did not send. Check your connection and try again.');
        }
        send.disabled = false;
        send.textContent = 'Send my link';
      });
    </script>

    <style>
      .join { background: var(--bg-accent); min-height: 100vh; margin: 0; font-family: 'Jost', system-ui, sans-serif; color: var(--text); }
      .join-top { background: #fff; border-bottom: 1px solid var(--line); padding: 0.75rem 1rem; }
      .join-top img { display: block; height: 32px; width: auto; }
      .join-main { max-width: 34rem; margin: 0 auto; padding: 1rem 1rem 3rem; }
      .join-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem 1rem 1.5rem; }
      .join-card h1 { font-size: 1.5rem; margin: 0 0 0.25rem; color: var(--hs-navy); }
      .join-sub { margin: 0 0 1rem; color: var(--muted); }
      .join-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
      .join-field { display: grid; gap: 0.2rem; margin-top: 0.75rem; font-weight: 600; font-size: 0.92rem; }
      .join-field input,
      .join-field select {
        font: inherit; font-weight: 400; font-size: 1rem; padding: 0.65rem 0.75rem; min-height: 44px;
        border: 1px solid #c3cad6; border-radius: 10px; background: #fff; color: var(--text); width: 100%; box-sizing: border-box;
      }
      .join-field input:focus-visible,
      .join-field select:focus-visible { outline: 3px solid var(--hs-blue); outline-offset: 1px; }
      .join-hint { font-weight: 400; font-size: 0.82rem; color: var(--muted); }
      .join-err { font-weight: 500; font-size: 0.85rem; color: var(--btn-red); }
      .join-err:empty { display: none; }
      .join-alert { margin: 1rem 0 0; color: var(--btn-red); font-weight: 500; }
      .join-send {
        margin-top: 1.25rem; width: 100%; min-height: 48px; border: 0; border-radius: 12px;
        background: var(--btn-red); color: #fff; font: inherit; font-weight: 600; font-size: 1.05rem; cursor: pointer;
      }
      .join-send:disabled { opacity: 0.6; cursor: default; }
      @media (max-width: 360px) { .join-row { grid-template-columns: 1fr; } }
    </style>
  </body>
</html>
